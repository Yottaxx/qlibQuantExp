QuantMoEModel(
  (feature_tokenizer): FeatureTokenizer()
  (factor_id_emb): Embedding(158, 64)
  (emb_dropout): Dropout(p=0.1, inplace=False)
  (time_embedding): RegimeAdaptiveTimeEmbedding(
    (tau_norm): LayerNorm((64,), eps=1e-05, elementwise_affine=True)
    (tau_fc1): Linear(in_features=64, out_features=32, bias=True)
    (tau_fc2): Linear(in_features=32, out_features=1, bias=True)
  )
  (factor_gate): RegimeAdaptiveFactorGate(
    (regime_norm): LayerNorm((64,), eps=1e-05, elementwise_affine=True)
    (factor_norm): LayerNorm((64,), eps=1e-05, elementwise_affine=True)
    (proj_gamma): Linear(in_features=64, out_features=64, bias=False)
    (proj_beta): Linear(in_features=64, out_features=64, bias=False)
  )
  (regime_encoder): RegimeContextEncoder(
    (encoder): Sequential(
      (0): Linear(in_features=102, out_features=128, bias=True)
      (1): Tanh()
      (2): Dropout(p=0.1, inplace=False)
      (3): Linear(in_features=128, out_features=64, bias=True)
      (4): LayerNorm((64,), eps=1e-05, elementwise_affine=True)
    )
  )
  (layers): ModuleList(
    (0-1): 2 x RegimeAdaptiveMoEBlock(
      (layer_summary_proj): Linear(in_features=128, out_features=64, bias=False)
      (router): Sequential(
        (0): Linear(in_features=128, out_features=32, bias=True)
        (1): GELU(approximate='none')
        (2): Linear(in_features=32, out_features=3, bias=True)
      )
      (time_expert): ParallelAttention(
        (mha): MultiheadAttention(
          (out_proj): NonDynamicallyQuantizableLinear(in_features=64, out_features=64, bias=False)
        )
      )
      (factor_expert): ParallelAttention(
        (mha): MultiheadAttention(
          (out_proj): NonDynamicallyQuantizableLinear(in_features=64, out_features=64, bias=False)
        )
      )
      (stock_expert): ParallelAttention(
        (mha): MultiheadAttention(
          (out_proj): NonDynamicallyQuantizableLinear(in_features=64, out_features=64, bias=False)
        )
      )
      (norm1): LayerNorm((64,), eps=1e-05, elementwise_affine=True)
      (norm2): LayerNorm((64,), eps=1e-05, elementwise_affine=True)
      (ffn): Sequential(
        (0): Linear(in_features=64, out_features=128, bias=True)
        (1): GELU(approximate='none')
        (2): Dropout(p=0.1, inplace=False)
        (3): Linear(in_features=128, out_features=64, bias=True)
        (4): Dropout(p=0.1, inplace=False)
      )
    )
  )
  (final_norm): LayerNorm((64,), eps=1e-05, elementwise_affine=True)
  (factor_pooling): AdaptivePooling(
    (attention_pool): AttentionPooling(
      (mha): MultiheadAttention(
        (out_proj): NonDynamicallyQuantizableLinear(in_features=64, out_features=64, bias=False)
      )
      (norm): LayerNorm((64,), eps=1e-05, elementwise_affine=True)
    )
  )
  (head): Linear(in_features=64, out_features=1, bias=True)
)

